{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mirops add-on compatibility entry",
  "type": "object",
  "required": ["name", "source", "rules"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "kebab-case id; must match the add-on the collector detects"
    },
    "displayName": { "type": "string" },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "the official vendor support table these ranges were taken from"
    },
    "lastVerified": {
      "type": "string",
      "description": "YYYY-MM when the ranges were confirmed against source"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["addonRange", "k8sRange"],
        "additionalProperties": false,
        "properties": {
          "addonRange": { "type": "string", "minLength": 1 },
          "k8sRange": { "type": "string", "minLength": 1 },
          "bestEffort": {
            "type": "boolean",
            "description": "true = extrapolated, not vendor-confirmed"
          }
        }
      }
    }
  }
}
