{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mirops add-on compatibility entry",
  "type": "object",
  "required": ["name", "displayName", "source", "lastVerified", "rules"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "kebab-case id; must match the add-on the collector detects"
    },
    "displayName": { "type": "string" },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "the official vendor support table these ranges were taken from"
    },
    "lastVerified": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "description": "YYYY-MM when the ranges were confirmed against source"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["addonRange", "k8sRange"],
        "additionalProperties": false,
        "properties": {
          "addonRange": { "type": "string", "minLength": 1 },
          "k8sRange": { "type": "string", "minLength": 1 },
          "bestEffort": {
            "type": "boolean",
            "description": "true = community-tested, not vendor-supported"
          },
          "evidence": {
            "type": "string",
            "format": "uri",
            "description": "URL documenting a reproducible community test when bestEffort is true"
          }
        }
      }
    }
  }
}
